{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio-app/browser",
  "headers": [
    {
      "source": "/(.*).(png|jpg|jpeg|svg|ico|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
